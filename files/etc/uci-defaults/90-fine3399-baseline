#!/bin/sh
set -eu

uci -q batch <<'EOF'
set system.@system[0].hostname='Fine3399'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].timezone='CST-8'
commit system
EOF

# Match the tested live port assignment: the onboard GMAC is PPPoE WAN and
# the USB RTL8152 adapter is the LAN bridge port. Do not copy credentials.
lan_bridge_section=
for section in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)=device$/\1/p"); do
	if [ "$(uci -q get "network.${section}.name")" = 'br-lan' ]; then
		lan_bridge_section=$section
		break
	fi
done
if [ -z "$lan_bridge_section" ]; then
	lan_bridge_section=$(uci add network device)
	uci -q set "network.${lan_bridge_section}.name=br-lan"
	uci -q set "network.${lan_bridge_section}.type=bridge"
fi
uci -q delete "network.${lan_bridge_section}.ports" || true
uci -q add_list "network.${lan_bridge_section}.ports=eth1"
uci -q set network.lan.device='br-lan'
uci -q set network.wan.device='eth0'
uci -q set network.wan6.device='eth0'
uci -q commit network

# The BCM43362 SDIO device is enumerated before the ImageBuilder rootfs
# finishes loading its ophub module bundle. AutoProbe therefore misses the
# original hotplug event, so load it explicitly before generating Wi-Fi UCI.
modprobe brcmfmac 2>/dev/null || true
wifi_wait=0
while [ "$wifi_wait" -lt 10 ] && ! ls /sys/class/ieee80211/phy* >/dev/null 2>&1; do
	sleep 1
	wifi_wait=$((wifi_wait + 1))
done

if ls /sys/class/ieee80211/phy* >/dev/null 2>&1 && \
	! uci -q show wireless | grep -q '=wifi-device'; then
	wifi config
fi

for radio in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-device$/\1/p"); do
	uci -q set "wireless.${radio}.country=CN"
	# Keep the radio off until an encrypted SSID is configured in LuCI.
	uci -q set "wireless.${radio}.disabled=1"
done
for iface in $(uci -q show wireless | sed -n "s/^wireless\.\([^.=]*\)=wifi-iface$/\1/p"); do
	uci -q set "wireless.${iface}.disabled=1"
done
uci -q commit wireless

# /etc/modules.d is not sufficient on every ophub boot: the SDIO device can
# be enumerated after kmodloader's pass.  Keep an explicit early boot loader.
if [ -x /etc/init.d/fine3399-wifi ]; then
	/etc/init.d/fine3399-wifi enable || true
fi

# Services needing credentials or policy stay off until configured in LuCI.
for service in openclash frps ddns-go sqm dockerd samba4 wsdd2 miniupnpd; do
	[ -x "/etc/init.d/${service}" ] && "/etc/init.d/${service}" disable || true
done

# Preserve the current OpenClash policy without enabling traffic interception.
# The service stays disabled until a proxy profile is configured deliberately.
if uci -q show openclash.config >/dev/null 2>&1; then
	uci -q batch <<'EOF'
set openclash.config.enable='0'
set openclash.config.en_mode='redir-host'
set openclash.config.ipv6_enable='1'
set openclash.config.enable_redirect_dns='2'
set openclash.config.router_self_proxy='1'
set openclash.config.china_ip_route='1'
set openclash.config.skip_proxy_address='1'
commit openclash
EOF
	[ -x /etc/init.d/openclash ] && /etc/init.d/openclash disable || true
fi

# Use the working 1Hosts Lite list, but do not reject LAN clients' external
# DNS/DoT. A failed list download must never make connected devices lose DNS.
if uci -q show adblock-fast.config >/dev/null 2>&1; then
	adblock_list_found=0
	for section in $(uci -q show adblock-fast | sed -n "s/^adblock-fast\\.\\([^.=]*\\)=file_url$/\\1/p"); do
		if [ "$(uci -q get "adblock-fast.${section}.name")" = '1Hosts - Lite' ]; then
			uci -q set "adblock-fast.${section}.enabled=1"
			adblock_list_found=1
		else
			uci -q set "adblock-fast.${section}.enabled=0"
		fi
	done
	uci -q set adblock-fast.config.force_dns='0'
	if [ "$adblock_list_found" -eq 1 ]; then
		uci -q set adblock-fast.config.enabled='1'
		[ -x /etc/init.d/adblock-fast ] && /etc/init.d/adblock-fast enable || true
	else
		uci -q set adblock-fast.config.enabled='0'
		[ -x /etc/init.d/adblock-fast ] && /etc/init.d/adblock-fast disable || true
	fi
	uci -q commit adblock-fast
fi

# Docker Hub is frequently unreachable from the target network. Keep this as
# an ordinary UCI entry so it remains replaceable from Dockerman.
if uci -q show dockerd.globals >/dev/null 2>&1; then
	uci -q delete dockerd.globals.registry_mirrors || true
	uci -q add_list dockerd.globals.registry_mirrors='https://docker.1panel.live'
	uci -q commit dockerd
fi

# Bonjour/mDNS discovery is restricted to br-lan by avahi-daemon.conf.
if [ -x /etc/init.d/avahi-daemon ]; then
	/etc/init.d/avahi-daemon enable || true
	/etc/init.d/avahi-daemon restart || true
fi

# Nginx starts without any listeners; Nginx UI owns the site configuration.
# This preserves LuCI on uHTTPd ports 80/443 until a deliberate migration.
if [ -x /etc/init.d/nginx ]; then
	/etc/init.d/nginx enable || true
	/etc/init.d/nginx restart || true
fi
if [ -x /etc/init.d/nginx-ui ]; then
	/etc/init.d/nginx-ui enable || true
	/etc/init.d/nginx-ui restart || true
fi

exit 0
